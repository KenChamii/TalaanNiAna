# Copy to .env and fill in. .env is ignored by git and must never be committed.

# Database
# Host-side port. 5433 by default to avoid a natively installed PostgreSQL on 5432.
DB_PORT=5433
POSTGRES_DB=talaanniana
POSTGRES_USER=talaanniana
POSTGRES_PASSWORD=localdev

# Token signing. At least 32 characters. Generate one with:
#   openssl rand -base64 48
# Use a different value in production from the one you develop with.
JWT_KEY= kJTYGdm14xZXwofnzYQjXstJe+GN9Dfbx7TkY/NYDFUEV4gutw9xVVW38vExjuiA
JWT_ISSUER=TalaanNiAna
JWT_AUDIENCE=TalaanNiAnaUsers

# Where the browser reaches the stack. nginx serves the app and proxies /api to
# the API, so one port covers both and the API is not published directly.
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080
